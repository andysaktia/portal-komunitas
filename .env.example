# Notion integration token — https://www.notion.so/my-integrations
NOTION_TOKEN=

# Database IDs (32-char id from each database's URL). Leave any of these
# blank and that section automatically falls back to the mock data in
# lib/mock-data.ts, so the site keeps working while you build out Notion.
NOTION_DB_WARTA=
NOTION_DB_RENUNGAN=
NOTION_DB_POKOK_DOA_PERIODE=
NOTION_DB_POKOK_DOA_POIN=
NOTION_DB_GALERI_EVENT=
NOTION_DB_GALERI_PHOTO=
NOTION_DB_LAPORAN=
NOTION_DB_PENGURUS=
